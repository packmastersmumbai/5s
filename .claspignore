# Node-based Playwright E2E harness — must NOT be pushed to Apps Script
# (they use require()/module.exports and collide in the GAS global scope).
e2e-lib-5s.js
e2e-*.js
node_modules/**
package.json
package-lock.json

# One-off Node verification scripts (created ad hoc during a session, e.g.
# with require() to call e2e-lib-5s). clasp push does NOT delete files that
# vanish locally — a leaked _tmp.js here breaks every clasp run call with
# "ReferenceError: require is not defined" until it's overwritten remotely.
# Naming convention: always suffix throwaway Node scripts with _tmp.js.
*_tmp.js

# Retired files — quarantined, NEVER push, never reference, never revive
# without reading _unused/README.md first. See that file for what each one
# was and why it was retired.
_unused/**

# Docs / GitHub Pages (served outside GAS)
docs/**
scripts/**

# Local-only artifacts
creds.json
auth.json
auth-gas.json
*.md
*.txt
*.png
*.yaml
*.yml
